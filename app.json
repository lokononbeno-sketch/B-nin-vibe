{
  "expo": {
    "name": "Bénin Vibe",
    "slug": "benin-vibe-2004",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "whatsapp",
          "fb",
          "fbapi",
          "fbshareextension"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "https",
              "host": "vibeout.app",
              "pathPrefix": "/e"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "package": "com.beninvibe.app",
      "versionCode": 2
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "0614528e-c00a-4126-849b-c37aca93a066"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/0614528e-c00a-4126-849b-c37aca93a066"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "benolilokonon",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Bénin Vibe utilise tes photos pour ajouter une affiche à tes événements et une photo à ton profil.",
          "cameraPermission": "Bénin Vibe utilise ton appareil photo pour prendre une photo de profil ou une affiche."
        }
      ]
    ],
    "experiments": {
      "baseUrl": "/B-nin-vibe"
    }
  }
}